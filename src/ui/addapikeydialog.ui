      <string>Enter a NexusMods API key:</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLineEdit" name="key_field"/>
   </item>
   <item>
    <widget class="QLabel" name="label_2">
     <property name="text">
      <string>Choose a master password for key encryption. If you set one, you will be prompted for it whenever the API key is accessed, and only this password can decrypt the key.

If you leave this empty, the key is NOT protected by a password. It is encrypted with a random key unique to this installation, stored in a file readable only by your user account (chmod 600). This keeps the key out of plain sight and avoids any shared/hardcoded password, but anyone who can read your account's files can still recover the key. For real protection, set a master password.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="PasswordField" name="pw_field" native="true"/>
   </item>
